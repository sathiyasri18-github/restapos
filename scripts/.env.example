# Resta POS — Docker environment variables
# Copy to .env and adjust before first deploy (from scripts/):
#   copy .env.example .env

# External SQL Server (API ConnectionStrings__DefaultConnection)
# Replace YOUR_SA_PASSWORD with the real SA password (SSMS masks it when copying).
SQL_DATA_SOURCE=194.163.139.218,1433
SQL_DATABASE=restapos
RESTAPOS_MSSQL_SA_PASSWORD=RestaPos@2024!

# Full connection string for Docker API (overrides appsettings.Docker.json)
# Password must match the remote SA password.
ConnectionStrings__DefaultConnection=Data Source=194.163.139.218,1433;Persist Security Info=True;User ID=sa;Password=RestaPos@2024!;Database=restapos;Pooling=False;MultipleActiveResultSets=False;Encrypt=True;TrustServerCertificate=True;Command Timeout=0

# Host ports
WEB_PORT=8080
API_PORT=8081
SQL_PORT=1433

# API secrets (override defaults in production)
JWT_KEY=RestaPos_Docker_SigningKey_Min32Chars!
JWT_ISSUER=CustomerApi
JWT_AUDIENCE=SystemService

# Image tag for pre-built client deploy (scripts/docker-compose.client.yml)
# RESTAPOS_VERSION=latest
