@page "/"
@rendermode InteractiveServer
@implements IDisposable
@inject ApiService Api

<SeoHead Title="Resta"
         FullTitleOverride="Resta | Restaurant"
         Description="Resta — seasonal dishes, house specialties, and a warm dining experience. Explore our menu, gallery, and events."
         Keywords="Resta, restaurant, dining, specialties, gallery, reservations, menu"
         CanonicalPath="/"
         JsonLd=@_orgJsonLd />

@if (_data == null)
{
    <div class="loading">Loading...</div>
}
else
{
    <section class="hero-carousel">
        @if (_data.Banners.Count > 0)
        {
            @for (var i = 0; i < _data.Banners.Count; i++)
            {
                var banner = _data.Banners[i];
                <div class="carousel-slide @(_currentSlide == i ? "active" : "")">
                    <div class="carousel-bg" style="background-image: linear-gradient(rgba(20,20,20,0.55), rgba(20,20,20,0.45)), url('@Media.Resolve(banner.ImageUrl)')"></div>
                </div>
            }
        }
        else if (_slideshowImages.Count > 0)
        {
            @for (var i = 0; i < _slideshowImages.Count; i++)
            {
                var slide = _slideshowImages[i];
                <div class="carousel-slide @(_currentSlide == i ? "active" : "")">
                    <div class="carousel-bg" style="background-image: linear-gradient(rgba(20,20,20,0.55), rgba(20,20,20,0.45)), url('@Media.Resolve(slide.ImageUrl)')"></div>
                </div>
            }
        }
        else
        {
            <div class="carousel-slide active">
                <div class="carousel-bg hero-default"></div>
            </div>
        }

        <div class="container carousel-content">
            @if (_data.Banners.Count > 0)
            {
                var banner = _data.Banners[_currentSlide];
                <p class="hero-eyebrow">Welcome @(_data.Settings?.AssociationName ?? "Resta") Restaurant</p>
                <h1>@(string.IsNullOrWhiteSpace(banner.Title) ? "Loves healthy food" : banner.Title)</h1>
                <p>@(string.IsNullOrWhiteSpace(banner.Subtitle) ? (_data.Settings?.Tagline ?? "Seasonal cooking and warm hospitality.") : banner.Subtitle)</p>
                <a href="@(string.IsNullOrEmpty(banner.LinkUrl) ? "/menu" : banner.LinkUrl)" class="btn btn-primary">Order now</a>
            }
            else if (_slideshowImages.Count > 0)
            {
                var slide = _slideshowImages[_currentSlide];
                <p class="hero-eyebrow">Welcome @(_data.Settings?.AssociationName ?? "Resta") Restaurant</p>
                <h1>@slide.Title</h1>
                <p>@(slide.Caption ?? _data.Settings?.Tagline)</p>
                <a href="/menu" class="btn btn-primary">Order now</a>
            }
            else
            {
                <p class="hero-eyebrow">Welcome @(_data.Settings?.AssociationName ?? "Resta") Restaurant</p>
                <h1>Loves healthy food</h1>
                <p>@(_data.Settings?.Tagline ?? "Seasonal cooking, warm service, and memorable meals.")</p>
                <a href="/menu" class="btn btn-primary">Order now</a>
            }
        </div>

        @if (SlideCount > 1)
        {
            <div class="carousel-dots">
                @for (var i = 0; i < SlideCount; i++)
                {
                    var index = i;
                    <button type="button" class="carousel-dot @(_currentSlide == index ? "active" : "")"
                            aria-label="Go to slide @(index + 1)"
                            @onclick="() => GoToSlide(index)"></button>
                }
            </div>
            <button type="button" class="carousel-nav carousel-prev" aria-label="Previous slide" @onclick="PrevSlide">&#8249;</button>
            <button type="button" class="carousel-nav carousel-next" aria-label="Next slide" @onclick="NextSlide">&#8250;</button>
        }
    </section>

    <section class="section">
        <div class="container two-col reveal">
            <div>
                <span class="section-overline">Our story</span>
                <h2 class="section-title">About @(_data.Settings?.AssociationName ?? "Resta")</h2>
                <p class="intro-text">@(_data.Settings?.AboutContent ?? "Resta is a neighborhood restaurant focused on seasonal cooking, warm service, and memorable meals.")</p>
                <a href="/about" class="btn btn-outline">Read more</a>
            </div>
            @if (!string.IsNullOrEmpty(_aboutImageUrl))
            {
                <div class="about-visual" style="background-image: url('@Media.Resolve(_aboutImageUrl)')" role="img" aria-label="Restaurant ambiance"></div>
            }
            else
            {
                <div class="stats-card">
                    <div class="stat"><strong>Fresh</strong><span>Seasonal Ingredients</span></div>
                    <div class="stat"><strong>Local</strong><span>Neighborhood Favorite</span></div>
                    <div class="stat"><strong>Warm</strong><span>Welcoming Hospitality</span></div>
                </div>
            }
        </div>
    </section>

    @if (PopularDishes.Any())
    {
        <section class="section bg-light">
            <div class="container">
                <div class="section-header reveal">
                    <span class="section-overline">Chef's selection</span>
                    <h2 class="section-title">Our popular dishes</h2>
                    <p class="section-intro">Signature plates our guests return for — crafted with seasonal produce and careful technique.</p>
                </div>
                <div class="dish-grid">
                    @foreach (var dish in PopularDishes)
                    {
                        <a href="/menu/@dish.Slug" class="dish-card">
                            <div class="dish-card-bg" style="background-image: url('@Media.Resolve(dish.CoverImageUrl ?? "/images/news-placeholder.jpg")')"></div>
                            <div class="dish-card-body">
                                <h3>@dish.Title</h3>
                                @if (!string.IsNullOrEmpty(dish.Subtitle))
                                {
                                    <p>@dish.Subtitle</p>
                                }
                            </div>
                        </a>
                    }
                </div>
                <div class="text-center mt-4">
                    <a href="/menu" class="btn btn-primary">View full menu</a>
                </div>
            </div>
        </section>
    }

    @if (_services.Any())
    {
        <section class="section">
            <div class="container">
                <div class="section-header reveal">
                    <span class="section-overline">From the kitchen</span>
                    <h2 class="section-title">Our food menu</h2>
                    <p class="section-intro">Browse favorites from the board. Filter to see chef picks or the full list.</p>
                </div>
                <div class="filter-tabs">
                    <button type="button" class="@(_menuFilter == "all" ? "active" : null)" @onclick='() => SetMenuFilter("all")'>All items</button>
                    <button type="button" class="@(_menuFilter == "featured" ? "active" : null)" @onclick='() => SetMenuFilter("featured")'>Chef's picks</button>
                </div>
                <div class="menu-list">
                    @foreach (var item in FilteredMenu)
                    {
                        <a href="/menu/@item.Slug" class="menu-list-item">
                            <div class="menu-item-thumb" style="background-image: url('@Media.Resolve(item.CoverImageUrl ?? "/images/news-placeholder.jpg")')"></div>
                            <div>
                                <div class="menu-item-title">@item.Title</div>
                                <div class="menu-item-meta">@(item.Subtitle ?? "House specialty")</div>
                            </div>
                            @if (item.IsFeatured)
                            {
                                <span class="menu-item-mark">Featured</span>
                            }
                        </a>
                    }
                </div>
                <div class="text-center mt-4">
                    <a href="/menu" class="btn btn-outline">Explore menu</a>
                </div>
            </div>
        </section>
    }

    @if (_albums.Any() || _slideshowImages.Any())
    {
        <section class="section bg-light">
            <div class="container">
                <div class="section-header reveal">
                    <span class="section-overline">Moments</span>
                    <h2 class="section-title">Our gallery</h2>
                    <p class="section-intro">A look inside our dining room, kitchen, and plated dishes.</p>
                </div>
                <div class="gallery-strip">
                    @if (_albums.Any())
                    {
                        @foreach (var album in _albums.Take(6))
                        {
                            <a href="/gallery/@album.Id" class="gallery-strip-item" style="background-image: url('@Media.Resolve(album.CoverImageUrl ?? "/images/news-placeholder.jpg")')">
                                <span>@album.Title</span>
                            </a>
                        }
                    }
                    else
                    {
                        @foreach (var img in _slideshowImages.Take(6))
                        {
                            <a href="/gallery" class="gallery-strip-item" style="background-image: url('@Media.Resolve(img.ImageUrl)')">
                                <span>@img.Title</span>
                            </a>
                        }
                    }
                </div>
                <div class="text-center mt-4">
                    <a href="/gallery" class="btn btn-primary">View gallery</a>
                </div>
            </div>
        </section>
    }

    <section class="reserve-cta">
        <span class="section-overline">Reservations</span>
        <h2 class="section-title">Make a reservation</h2>
        <p>Book a table for dinner, celebrations, or private dining. We will confirm your preferred time.</p>
        <a href="/contact" class="btn btn-primary">Reserve a table</a>
    </section>

    @if (_data.FeaturedNews.Any())
    {
        <section class="section">
            <div class="container">
                <div class="section-header reveal">
                    <span class="section-overline">Stories</span>
                    <h2 class="section-title">Our blog</h2>
                    <p class="section-intro">News from the kitchen, seasonal menus, and dining events.</p>
                </div>
                <div class="card-grid">
                    @foreach (var news in _data.FeaturedNews.Take(4))
                    {
                        <article class="news-card">
                            <div class="news-card-img" style="background-image: url('@Media.Resolve(news.ImageUrl ?? "/images/news-placeholder.jpg")')"></div>
                            <div class="news-card-body">
                                <span class="badge">@(news.PublishedAt?.ToString("dd MMM") ?? news.Category.ToString())</span>
                                <h3><a href="/news/@news.Slug">@news.Title</a></h3>
                                <p>@news.Summary</p>
                            </div>
                        </article>
                    }
                </div>
                <div class="text-center mt-4">
                    <a href="/news" class="btn btn-outline">View all news</a>
                </div>
            </div>
        </section>
    }

    @if (HomePromo is not null)
    {
        <section class="section" style="padding-top: 0;">
            <div class="container">
                <div class="promo-banner">
                    <div class="promo-banner-media" style="background-image: url('@Media.Resolve(HomePromo.ImageUrl)')"></div>
                    <div class="promo-banner-body">
                        <span class="section-overline">Special offer</span>
                        <h2>@HomePromo.Title</h2>
                        <p>Join us for a seasonal special — limited seating available.</p>
                        @if (!string.IsNullOrEmpty(HomePromo.LinkUrl))
                        {
                            <a href="@HomePromo.LinkUrl" class="btn btn-primary">Order now</a>
                        }
                        else
                        {
                            <a href="/contact" class="btn btn-primary">Learn more</a>
                        }
                    </div>
                </div>
            </div>
        </section>
    }

    @if (_data.UpcomingEvents.Any())
    {
        <section class="section bg-light">
            <div class="container">
                <div class="section-header reveal">
                    <span class="section-overline">Gatherings</span>
                    <h2 class="section-title">Upcoming events</h2>
                    <p class="section-intro">Private dining, tastings, and evenings worth saving.</p>
                </div>
                <div class="event-list">
                    @foreach (var evt in _data.UpcomingEvents)
                    {
                        <div class="event-item">
                            <div class="event-date">
                                <strong>@evt.StartDate.Day</strong>
                                <span>@evt.StartDate.ToString("MMM")</span>
                            </div>
                            <div>
                                <h3>@evt.Title</h3>
                                <p>@evt.Location</p>
                            </div>
                        </div>
                    }
                </div>
                <div class="text-center mt-4">
                    <a href="/events" class="btn btn-primary">Events / private dining</a>
                </div>
            </div>
        </section>
    }
}

@code {
    private HomePageData? _data;
    private List<GalleryImageDto> _slideshowImages = [];
    private List<GalleryAlbumDto> _albums = [];
    private List<ServiceDto> _services = [];
    private string _menuFilter = "all";
    private int _currentSlide;
    private Timer? _timer;
    private const int SlideIntervalMs = 6000;

    private int SlideCount =>
        _data?.Banners.Count > 0 ? _data.Banners.Count : _slideshowImages.Count;

    private IEnumerable<ServiceDto> PopularDishes
    {
        get
        {
            var featured = _services.Where(s => s.IsFeatured).Take(6).ToList();
            return featured.Count > 0 ? featured : _services.Take(6);
        }
    }

    private IEnumerable<ServiceDto> FilteredMenu =>
        _menuFilter == "featured"
            ? _services.Where(s => s.IsFeatured).Take(8)
            : _services.Take(8);

    private AdvertisementDto? HomePromo =>
        _data?.Advertisements.FirstOrDefault(a => a.Position == AdvertisementPosition.HomeBanner)
        ?? _data?.Advertisements.FirstOrDefault();

    private string? _aboutImageUrl =>
        _albums.FirstOrDefault()?.CoverImageUrl
        ?? _slideshowImages.FirstOrDefault()?.ImageUrl
        ?? PopularDishes.FirstOrDefault()?.CoverImageUrl;

    protected override async Task OnInitializedAsync()
    {
        _data = await Api.GetAsync<HomePageData>("api/public");
        _slideshowImages = (await Api.GetAsync<List<GalleryImageDto>>("api/public/gallery/slideshow")) ?? [];
        _albums = (await Api.GetAsync<List<GalleryAlbumDto>>("api/public/gallery")) ?? [];
        _services = _data?.Services ?? (await Api.GetAsync<List<ServiceDto>>("api/public/services?limit=10")) ?? [];
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender && SlideCount > 1)
            StartTimer();
    }

    private void SetMenuFilter(string filter)
    {
        _menuFilter = filter;
    }

    private void StartTimer()
    {
        _timer?.Dispose();
        _timer = new Timer(_ => InvokeAsync(() =>
        {
            NextSlide();
            return Task.CompletedTask;
        }), null, SlideIntervalMs, SlideIntervalMs);
    }

    private void NextSlide()
    {
        if (SlideCount == 0) return;
        _currentSlide = (_currentSlide + 1) % SlideCount;
        StateHasChanged();
    }

    private void PrevSlide()
    {
        if (SlideCount == 0) return;
        _currentSlide = (_currentSlide - 1 + SlideCount) % SlideCount;
        ResetTimer();
    }

    private void GoToSlide(int index)
    {
        _currentSlide = index;
        ResetTimer();
    }

    private void ResetTimer()
    {
        if (SlideCount > 1)
            StartTimer();
    }

    public void Dispose() => _timer?.Dispose();

    private string _orgJsonLd => System.Text.Json.JsonSerializer.Serialize(new
    {
        @__context = "https://schema.org",
        @__type = "Restaurant",
        name = "Resta",
        url = "https://resta.com",
        logo = "https://resta.com/images/logo.png",
        description = _data?.Settings?.AboutContent ?? "A welcoming restaurant serving seasonal dishes and memorable dining experiences.",
        address = new { @__type = "PostalAddress", streetAddress = _data?.Settings?.Address ?? "" },
        telephone = _data?.Settings?.Phone ?? "",
        email = _data?.Settings?.Email ?? "info@resta.com",
        sameAs = Array.Empty<string>()
    }).Replace("\"__context\"", "\"@context\"")
      .Replace("\"__type\"", "\"@type\"");
}
