<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content="Resta — a welcoming restaurant serving seasonal dishes, specialties, and memorable dining experiences." />
    <meta name="keywords" content="Resta, restaurant, dining, specialties, gallery, reservations, menu" />
    <meta name="resta-api-base" content="@(Configuration["ApiBaseUrl"] ?? "http://localhost:51269/")" />
    <base href="/" />

    <style>
        :root{--primary:#1B4332;--primary-light:#2D6A4F;--accent:#C4A35A;--text:#1a1a1a;--text-muted:#5a5a5a;--on-primary-muted:#d8f3dc;--bg:#FAFAF8;--bg-light:#F0F0EC;--border:#e0e0d8;--shadow:0 4px 6px -1px rgba(0,0,0,.1);--radius:8px}
        *{box-sizing:border-box;margin:0;padding:0}
        body{font-family:system-ui,sans-serif;color:var(--text);line-height:1.6;background:var(--bg);overflow-x:clip}
        .site-header{background:var(--bg);box-shadow:var(--shadow);position:sticky;top:0;z-index:100}
        .header-top{background:var(--primary);color:#fff;font-size:.85rem;padding:.4rem 0}
        .header-top-inner{display:flex;gap:2rem;flex-wrap:wrap}
        .container{max-width:1200px;margin:0 auto;padding:0 1.5rem;width:100%;min-width:0}
        .header-main{display:flex;align-items:center;justify-content:space-between;padding:1rem 1.5rem;max-width:1200px;margin:0 auto}
        .logo{display:flex;align-items:center;gap:.75rem;color:var(--text);text-decoration:none}
        .logo-icon{background:var(--primary);color:#fff;width:48px;height:48px;border-radius:var(--radius);display:flex;align-items:center;justify-content:center;font-weight:700;font-size:1.1rem}
        .logo strong{display:block;font-size:1rem;line-height:1.2;font-family:'Fraunces',Georgia,serif}
        .logo small{color:var(--text-muted);font-size:.75rem}
        .nav-toggle{display:none;background:none;border:none;font-size:1.5rem;cursor:pointer;padding:.5rem;min-width:44px;min-height:44px}
        .main-nav{display:flex;gap:.25rem;flex-wrap:wrap;align-items:center}
        .site-nav-check{display:none}
        .hero-carousel{position:relative;min-height:720px;height:min(88vh,920px);overflow:hidden;background:var(--primary)}
        .loading{text-align:center;padding:4rem;color:var(--text-muted)}
        @@media(max-width:768px){
            .header-main{display:grid;grid-template-columns:1fr auto;align-items:center;gap:.5rem;position:relative}
            .site-nav{display:contents}
            .logo{grid-column:1;grid-row:1;min-width:0}
            .nav-toggle{display:flex;align-items:center;justify-content:center;grid-column:2;grid-row:1}
            .main-nav{display:none;grid-column:1/-1;grid-row:2;background:var(--bg);flex-direction:column;padding:.5rem 0 1rem;box-shadow:var(--shadow);align-items:stretch;border-top:1px solid var(--border)}
            .site-nav-check:checked~.main-nav{display:flex}
            .visitor-count{display:none}
        }
    </style>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="preload" as="style"
          href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Source+Sans+3:wght@400;500;600;700&display=swap"
          onload="this.rel='stylesheet'" />
    <noscript>
        <link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600;9..144,700&family=Source+Sans+3:wght@400;500;600;700&display=swap" rel="stylesheet" />
    </noscript>

    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="css/cookieConsent.css" />
    <link rel="stylesheet" href="Resta.Web.styles.css" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="js/cookieConsent.js" defer></script>
    <script src="js/siteNav.js" defer></script>
    <script src="_framework/blazor.web.js"></script>
</body>

</html>

@code {
    [Inject] private IConfiguration Configuration { get; set; } = default!;
}
